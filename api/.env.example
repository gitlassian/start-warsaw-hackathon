GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://rollcall:rollcall@localhost:5432/rollcall
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rollcall
S3_SECRET_KEY=rollcall-secret
S3_BUCKET=rollcall
# true behind HTTPS in production
COOKIE_SECURE=false
# Browser-facing prefix for presigned URLs (default /s3 via the Next.js rewrite)
# S3_PUBLIC_URL=https://files.example.com
